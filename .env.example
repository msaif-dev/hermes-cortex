# ==============================================================================
# Hermes MCP Platform — Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment
# ------------------------------------------------------------------------------
APP_ENVIRONMENT=development        # development | staging | production | testing

# ------------------------------------------------------------------------------
# 2. LLM Provider Configuration (Google Gemini)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from: https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your-gemini-api-key-here
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 3. Slack Gateway Configuration (Bolt Socket Mode)
# ------------------------------------------------------------------------------
# Create an app at: https://api.slack.com/apps
# Bot Token: OAuth & Permissions -> Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App Token: Basic Information -> App-Level Tokens -> connections:write (xapp-...)
SLACK_APP_TOKEN=xapp-your-app-token

# ------------------------------------------------------------------------------
# 4. PostgreSQL Data Warehouse
# ------------------------------------------------------------------------------
# If using the included 'docker compose up -d', these match scripts/init-db.sql:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hermes
DB_USER=hermes_readonly
DB_PASSWORD=dev_readonly_password

# ------------------------------------------------------------------------------
# 5. Daytona Sandbox (Optional - Local isolated fallback used if left blank)
# ------------------------------------------------------------------------------
# Sign up at: https://app.daytona.io/
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# ------------------------------------------------------------------------------
# 6. Observability & Telemetry
# ------------------------------------------------------------------------------
OBS_LOG_LEVEL=INFO
OBS_LOG_FORMAT=console
OBS_METRICS_ENABLED=true
OBS_METRICS_PORT=9090
